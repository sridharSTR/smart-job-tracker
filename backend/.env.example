SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_URL=http://127.0.0.1:5173

# Use sqlite for quick local development.
# Set DATABASE_ENGINE=postgres when your PostgreSQL credentials are ready.
DATABASE_ENGINE=sqlite

POSTGRES_DB=smart_job_tracker
